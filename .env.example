# Copy to `.env` for local development. Never commit `.env`.

# tracing-subscriber EnvFilter directive.
RUST_LOG=info,rustagotchi_simulation=debug

# Which config/<profile>.ron to load. One of: development | production | simulation
RUSTAGOTCHI_PROFILE=development

# Overrides the per-OS save directory resolved by crates/platform/src/paths.rs.
# Useful for keeping test saves out of your real profile.
# RUSTAGOTCHI_DATA_DIR=./.local/saves

# Overrides the content pack root. Defaults to ./assets.
# RUSTAGOTCHI_ASSET_DIR=./assets

# Fixes the world seed so local runs are reproducible. Unset = random per new game.
# RUSTAGOTCHI_WORLD_SEED=42
